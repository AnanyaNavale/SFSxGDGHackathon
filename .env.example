# Copy this file to .env.local. Do not put real keys in this example file.
# .env.local stays on your computer and is not committed.

# Frontend. "true" uses sample answers. Set to "false" when the real
# /api/analyze-text endpoint is ready. This one is safe to expose.
NEXT_PUBLIC_USE_MOCK=true

# Backend only. Your partner fills these in on their machine and on Cloud Run.
# Do not put these in frontend code, and do not add NEXT_PUBLIC_ to them.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_API_KEY=your-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash
GEMMA_MODEL=gemma-4-26b-a4b-it
